---
import { t } from '../i18n';
import { getFeaturedForumPosts } from '../data/forum';
import SectionHeader from './SectionHeader.astro';
import ForumCard from './ForumCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs();
const featuredThreads = getFeaturedForumPosts(3);
const forumHome = t.forumHome;
---

<section id="forum" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="forum-home-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={forumHome.eyebrow} title={forumHome.title} desc={forumHome.subtitle} titleId="forum-home-title" />

    <div class="mt-12 grid items-stretch gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredThreads.map((post) => (
        <ForumCard post={post} />
      ))}
    </div>

    <div class="mt-10 flex justify-start lg:justify-center">
      <Button as="a" href={ROUTES.forum} variant="outline">
        {forumHome.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</section>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
