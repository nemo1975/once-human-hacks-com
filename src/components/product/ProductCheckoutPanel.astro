---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const previewFeatures = product.features.slice(0, 4);
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
>
  <div class="product-checkout__card flex h-full min-h-0 flex-col overflow-hidden rounded-xl border border-border bg-card">
    <div class="card-title-band flex items-center gap-2.5 border-b border-border px-4 py-3 text-left">
      <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
        <Icon name="acqPackage" size={16} />
      </span>
      <div class="min-w-0 text-left">
        <p class="text-[0.65rem] font-medium uppercase tracking-wider text-muted-foreground">Product</p>
        <h2 id={`checkout-${product.slug}`} class="truncate text-sm font-semibold leading-snug">
          {product.title}
        </h2>
      </div>
    </div>

    <div class="flex min-h-0 flex-1 flex-col gap-3 px-4 py-3">
      <p class="line-clamp-2 text-sm leading-snug text-muted-foreground">{product.subtitle}</p>

      <ul class="space-y-1.5 text-sm text-muted-foreground">
        {
          previewFeatures.map((feature) => (
            <li class="flex items-start gap-2">
              <Icon name="check" size={14} class="product-feature-check mt-0.5 shrink-0" />
              <span class="leading-snug">{feature}</span>
            </li>
          ))
        }
      </ul>
      {
        product.more > 0 && (
          <p class="text-xs text-muted-foreground">Plus {product.more} more in the list below.</p>
        )
      }

      <div class="mt-auto space-y-2 pt-1">
        <Button
          as="a"
          href={product.buyUrl}
          rel={product.buyUrl.startsWith('http') ? 'noopener noreferrer sponsored' : undefined}
          variant="primary"
          size="sm"
          class="w-full rounded-lg"
        >
          Buy Now
          <Icon name="arrowRight" size={16} />
        </Button>
        <p class="text-[0.7rem] leading-snug text-muted-foreground">
          Duration and payment are chosen on merchant checkout.
        </p>
      </div>
    </div>
  </div>
</aside>
