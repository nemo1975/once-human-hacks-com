---
import { REVIEW_SUMMARY, featuredReviews } from '../data/reviews';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';

---

<section id="reviews" class="border-y border-border bg-background py-16 md:py-24" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Player feedback"
      title="What PC players say after trying the modules"
      desc={`${REVIEW_SUMMARY.total}+ written reviews across aimbot, ESP, and loader setup — mixed opinions, no fluff.`}
      titleId="reviews-title"
    />

    <div class="mt-8 flex flex-wrap items-center gap-4 rounded-2xl border border-border/60 bg-card px-5 py-4">
      <p class="font-[family-name:var(--font-heading)] text-3xl font-bold text-foreground">{REVIEW_SUMMARY.average.toFixed(1)}</p>
      <div>
        <p class="text-sm font-semibold text-primary" aria-hidden="true">★★★★☆</p>
        <p class="text-sm text-muted-foreground">Average from {REVIEW_SUMMARY.total}+ reviews</p>
      </div>
    </div>

    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featuredReviews.map((review) => (
        <li class="rounded-2xl border border-border/60 bg-muted/20 p-5">
          <div class="flex items-center justify-between gap-2">
            <p class="font-medium text-foreground">{review.author}</p>
            <span class="text-xs text-muted-foreground">{review.when}</span>
          </div>
          <p class="mt-1 text-xs uppercase tracking-wide text-primary">{review.product}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{review.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
