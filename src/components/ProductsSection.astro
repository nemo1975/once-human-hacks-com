---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { hackPages, utilityPages } from '../data/products';
import SectionHeader from './SectionHeader.astro';
import ProductCatalogGrid from './ProductCatalogGrid.astro';

const s = t.products;
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />

    <div class="mt-12 space-y-16">
      <div id="hacks">
        <h3 class="text-xl font-semibold normal-case text-foreground">{s.hacksTitle}</h3>
        <p class="mt-2 max-w-2xl text-sm text-muted-foreground md:text-base">{s.hacksSubtitle}</p>
        <ProductCatalogGrid products={hackPages} class="mt-8" />
      </div>

      <div id="utilities">
        <h3 class="text-xl font-semibold normal-case text-foreground">{s.utilitiesTitle}</h3>
        <p class="mt-2 max-w-2xl text-sm text-muted-foreground md:text-base">{s.utilitiesSubtitle}</p>
        <ProductCatalogGrid products={utilityPages} class="mt-8" />
      </div>
    </div>
  </div>
</section>
