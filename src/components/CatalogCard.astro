---
import type { IconName } from './icons/types';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  label: string;
  title: string;
  href: string;
  buyUrl: string;
  features: string[];
  more?: number;
  icon?: IconName;
  badge?: string;
  variant?: 'essential' | 'popular' | 'limited';
  buyLabel?: string;
  viewLabel?: string;
  maxFeatures?: number;
  class?: string;
  wide?: boolean;
}

const {
  label,
  title,
  href,
  buyUrl,
  features,
  more = 0,
  icon = 'package',
  badge,
  variant,
  buyLabel = 'Buy now',
  viewLabel = 'View details',
  maxFeatures = 10,
  class: className,
  wide = false,
} = Astro.props;

const displayFeatures = features.slice(0, maxFeatures);
const isExternalCheckout = buyUrl.startsWith('http');
const externalLinkRel = isExternalCheckout ? 'noopener noreferrer sponsored' : undefined;

const statusBadgeIcon = (text: string): IconName => {
  if (/limited/i.test(text)) return 'alert';
  if (/private/i.test(label)) return 'shieldCheck';
  return 'circleCheck';
};
---

<Card
  class:list={[
    'group flex h-full min-w-0 overflow-hidden transition-shadow hover:shadow-md',
    wide ? 'catalog-card--wide flex-col' : 'flex-col',
    className,
  ]}
>
  <CardHeader class:list={['space-y-2.5', wide && 'catalog-card--wide__header']}>
    <CardTitle class="text-lg normal-case leading-snug">{title}</CardTitle>
    <div class:list={['catalog-card__badges flex flex-wrap items-start gap-1.5', !wide && 'min-h-[3.25rem]']}>
      <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
        <Icon name={icon} size={12} class="shrink-0" />
        {label}
      </Badge>
      {
        badge && (
          <Badge
            tone="primary"
            appearance="soft"
            size="sm"
            class="catalog-card__badge gap-1"
          >
            <Icon name={statusBadgeIcon(badge)} size={12} class="shrink-0" />
            {badge}
          </Badge>
        )
      }
      {variant === 'popular' && (
        <Badge tone="primary" appearance="solid" size="sm" class="catalog-card__badge gap-1">
          <Icon name="zap" size={12} class="shrink-0" />
          Popular
        </Badge>
      )}
      {
        variant === 'limited' && !badge?.toLowerCase().includes('limited') && (
          <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
            <Icon name="alert" size={12} class="shrink-0" />
            Limited
          </Badge>
        )
      }
    </div>
  </CardHeader>
  <CardContent class:list={['flex-1', wide && 'catalog-card--wide__body']}>
    <ul class="space-y-2 text-sm text-muted-foreground">
      {displayFeatures.map((feature) => (
        <li class="flex items-start gap-2">
          <Icon name="check" size={14} class="mt-0.5 shrink-0" />
          <span>{feature}</span>
        </li>
      ))}
      {more > 0 && <li class="text-xs text-muted-foreground">+{more} more features</li>}
    </ul>
  </CardContent>
  <CardFooter
    class:list={[
      'flex w-full min-w-0 flex-col gap-2',
      wide && 'catalog-card--wide__actions',
    ]}
  >
    <Button
      as="a"
      href={buyUrl}
      rel={externalLinkRel}
      variant="primary"
      size="sm"
      class="h-auto min-h-9 w-full whitespace-normal py-2 text-center leading-snug"
    >
      {buyLabel}
      <Icon name="arrowRight" size={17} />
    </Button>
    <Button
      as="a"
      href={href}
      variant="outline"
      size="sm"
      class="h-auto min-h-9 w-full whitespace-normal py-2 text-center leading-snug"
    >
      {viewLabel}
      <Icon name="arrowRight" size={17} />
    </Button>
  </CardFooter>
</Card>
