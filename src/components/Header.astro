---
import { t } from '../i18n';
import { PRIMARY_CHECKOUT_PATH } from '../config/checkout';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

import type { IconName } from './icons/types';

const navIconByHref: Record<string, IconName> = {
  '/': 'layers',
  '/products/once-human-hacks/': 'navProducts',
  '/blog/': 'navBlog',
  '/forum/': 'messageCircle',
  '/reviews/': 'users',
  '/faq/': 'navFaq',
};

const purchaseUrl = PRIMARY_CHECKOUT_PATH;
const externalLinkRel = 'noopener noreferrer sponsored';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="group/nav pointer-events-auto relative flex h-14 w-full max-w-[72rem] items-center justify-between gap-2 rounded-2xl border border-border/40 bg-background/35 px-3 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:px-4 lg:h-[3.75rem] xl:px-5"
      data-nav-bar
    >
    <a href="/" class="inline-flex min-w-0 items-center font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide" aria-label={t.ui.homeAria}>
      <span class="truncate" aria-hidden="true">Once Human <span class="text-primary">Hacks</span></span>
    </a>

    <nav
      id="primary-nav"
      class="absolute left-1/2 -translate-x-1/2 items-center gap-3 max-lg:inset-x-0 max-lg:top-[calc(100%+0.5rem)] max-lg:left-0 max-lg:z-50 max-lg:hidden max-lg:w-full max-lg:translate-x-0 max-lg:flex-col max-lg:items-stretch max-lg:gap-1 max-lg:rounded-2xl max-lg:border max-lg:border-border/40 max-lg:bg-background/95 max-lg:p-3 max-lg:shadow-lg max-lg:backdrop-blur-xl lg:flex xl:gap-4 group-data-[nav-open]/nav:max-lg:flex"
      aria-label="Primary"
    >
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex items-center gap-1 text-[13px] font-medium text-muted-foreground transition-colors hover:text-primary xl:gap-1.5 xl:text-sm max-lg:rounded-md max-lg:px-3 max-lg:py-2 max-lg:text-sm hover:max-lg:bg-muted"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIconByHref[link.href] ?? 'navFeatures'} size={15} class="shrink-0 lg:hidden xl:inline" />
          {link.label}
        </a>
      ))}
      <a
        href={purchaseUrl}
        rel={externalLinkRel}
        class="mt-1 inline-flex items-center justify-center rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground lg:hidden"
        aria-label={t.ui.browseCheatsMobile}
      >
        {t.ui.browseCheatsMobile}
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center sm:flex">
        <SlideRevealButton href={purchaseUrl} class="hidden lg:inline-flex" ariaLabel={t.ui.checkoutAria} rel={externalLinkRel}>
          {t.ui.browseCheats}
        </SlideRevealButton>
        <div class="nav-action-divider hidden items-center px-3 lg:flex" aria-hidden="true">
          <span class="block h-9 w-px bg-border"></span>
        </div>
        <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex" />
      </div>

      <button
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted lg:hidden"
        aria-label={t.ui.menuOpen}
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        <Icon name="menu" size={20} data-nav-icon-open />
        <Icon name="x" size={20} class="hidden" data-nav-icon-close />
      </button>
    </div>
    </div>
  </div>
</header>
