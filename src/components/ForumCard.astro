---
import type { ForumPost } from '../data/forum';
import Icon from './icons/Icon.astro';

interface Props {
  post: ForumPost;
}

const { post } = Astro.props;
const threadUrl = `/forum/${post.slug}/`;
---

<article class="flex h-full min-w-0 flex-col rounded-2xl border border-border/60 bg-card p-5 shadow-sm transition-colors hover:border-primary/40">
  <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{post.category}</p>
  <h3 class="mt-2 line-clamp-3 min-h-[4.5rem] font-[family-name:var(--font-heading)] text-lg font-semibold leading-snug">
    <a class="text-foreground hover:text-primary" href={threadUrl}>{post.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>
  <div
    class="mt-4 flex flex-col gap-3 border-t border-border/50 pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
  >
    <span class="inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground">
      <Icon name="messageCircle" size={14} />
      {post.commentsCount} replies
    </span>
    <a
      class="inline-flex min-w-0 items-center gap-1 text-xs font-semibold text-primary hover:underline"
      href={threadUrl}
      aria-label={`Open thread: ${post.title}`}
    >
      <Icon name="arrowRight" size={14} class="shrink-0" />
      Open thread
    </a>
  </div>
</article>
