---
import '../styles/blog-pages.css';
import type { BlogEntry } from '../lib/blog';
import { blogPostPath, blogReadGuideLabel, formatBlogDate, readingMinutes } from '../lib/blog';
import { Button } from '@/components/starwind/button';
import ResponsiveImage from './ResponsiveImage.astro';
import { resolveBlogHeroSource } from '../utils/blogHeroImage';
import { CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../utils/responsiveImage';
import Icon from './icons/Icon.astro';

interface Props {
  post: BlogEntry;
  heroAltPrefix?: string;
}

const { post, heroAltPrefix } = Astro.props;
const href = blogPostPath(post.id);
const heroSrc = resolveBlogHeroSource(post.data.heroImage);
const readMin = readingMinutes(post.body);
const readLabel = blogReadGuideLabel(post.id, post.data.title);
---

<article class="blog-card group flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-border/60 bg-card shadow-sm transition-colors hover:border-primary/40">
  <a href={href} class="block overflow-hidden">
    <ResponsiveImage
      src={heroSrc}
      alt={heroAltPrefix ? `${heroAltPrefix}${post.data.title}` : post.data.title}
      width={640}
      height={360}
      widths={CARD_IMAGE_WIDTHS}
      sizes={CARD_IMAGE_SIZES}
      loading="lazy"
      class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </a>
  <div class="flex min-h-0 flex-1 flex-col p-4 sm:p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-primary">{post.data.category}</p>
    <h2 class="mt-2 line-clamp-3 font-[family-name:var(--font-heading)] text-base font-semibold leading-snug md:text-lg">
      <a href={href} class="text-foreground hover:text-primary">{post.data.title}</a>
    </h2>
    <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
    <p class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
      <span>{formatBlogDate(post.data.date)}</span>
      <span aria-hidden="true">·</span>
      <span>{readMin} min read</span>
    </p>
    <Button
      as="a"
      href={href}
      variant="outline"
      size="sm"
      class="blog-card__cta mt-4 w-full justify-center sm:mt-auto"
      aria-label={`${readLabel}: ${post.data.title}`}
    >
      <span class="truncate">{readLabel}</span>
      <Icon name="arrowRight" size={15} class="shrink-0" />
    </Button>
  </div>
</article>
