---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import BlogShareBar from '../components/BlogShareBar.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Homepage', path: '/' },
  { name: 'FAQ index', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="FAQ – Once Human Hacks logo"
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="mx-auto mt-6 max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">Once Human Hacks</p>
        <h1 id="faq-page-title" class="mt-3 font-[family-name:var(--font-heading)] text-3xl font-bold normal-case tracking-tight md:text-4xl">
          Once Human Cheat FAQ: setup, plans, and account risk
        </h1>
        <p class="mt-2 text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">All questions</p>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t.faq.subtitle}</p>
        <div class="mt-6 flex justify-center">
          <BlogShareBar title={seo.title} path="/faq/" />
        </div>
      </header>
    </div>
  </section>

  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-title"
    hideHeader
    contentAlign="center"
    class="border-t border-border bg-background py-10 md:py-14"
  />
</BaseLayout>
