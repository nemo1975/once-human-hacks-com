---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewsPageList from '../components/ReviewsPageList.astro';
import BlogShareBar from '../components/BlogShareBar.astro';
import { REVIEW_SUMMARY } from '../data/reviews';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Homepage', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Reviews – Sand Hacks logo"
  jsonLd={[
    webPageSchema({ name: seo.title, description: seo.description, url: '/reviews/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <header class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Player feedback</p>
          <h1 class="mt-2 font-[family-name:var(--font-heading)] text-3xl font-bold md:text-4xl">Sand Hacks player reviews from PC extracts</h1>
          <p class="mt-3 text-muted-foreground">
            Community reviews on Sand Hacks for SAND: Raiders of Sophie. These are editorial examples for loader, ESP, and trampler talk—not verified purchase ratings or star aggregates.
          </p>
          <div class="mt-4">
            <BlogShareBar title={seo.title} path="/reviews/" />
          </div>
        </header>
        <div class="flex shrink-0 items-center gap-4 rounded-2xl border border-border/60 bg-card px-6 py-4 lg:min-w-[14rem]">
          <p class="font-[family-name:var(--font-heading)] text-4xl font-bold text-foreground">{REVIEW_SUMMARY.total}</p>
          <div>
            <p class="text-sm font-semibold text-primary">Reviews</p>
            <p class="text-sm text-muted-foreground">Community examples, unrated</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ReviewsPageList />
</BaseLayout>
