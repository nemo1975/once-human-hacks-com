---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BlogShareBar from '../components/BlogShareBar.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import PageSeoExpansion from '../components/PageSeoExpansion.astro';
import { supportExpansion, expansionFaqsToSchema } from '../data/pageExpansions';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const supportFaqs = expansionFaqsToSchema(supportExpansion.faqs);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support – Sand Hacks logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    faqPageSchema(supportFaqs),
    breadcrumbSchema([
      { name: 'Homepage', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Homepage', path: '/' },
        { name: 'Support', path: '/support/' },
      ]}
    />
    <div class="mt-6 flex justify-end">
      <BlogShareBar title={seo.title} path="/support/" />
    </div>
  </div>
  <ContactSupportSection titleId="support-page-title" showTicketTips headingLevel={1} />
  <PageSeoExpansion
    sections={supportExpansion.sections}
    table={supportExpansion.table}
    faqs={supportExpansion.faqs}
    faqHeading="Support FAQ"
    faqSubtitle="Setup, billing, HWID, and patch-day questions answered before you open a ticket."
    trustHeading={supportExpansion.trustHeading}
    trustItems={supportExpansion.trustItems}
    cta={supportExpansion.cta}
  />
</BaseLayout>
